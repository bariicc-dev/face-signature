# Supabase — get these from supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJxxx...
SUPABASE_SERVICE_ROLE_KEY=eyJxxx...

# Resend — get from resend.com/api-keys
RESEND_API_KEY=re_xxx...

# Admin email — where new booking notifications are sent
ADMIN_EMAIL=mariam@facesignature.paris

# From email (must be a verified domain on Resend, OR use 'onboarding@resend.dev' for testing)
FROM_EMAIL=onboarding@resend.dev

# Google Calendar — server-side booking mirror
# Calendar to receive owner agenda events. Use the calendar ID from Google Calendar settings.
GOOGLE_CALENDAR_ID=primary-or-calendar-id@group.calendar.google.com

# Google service account shared on the calendar with "Make changes to events" permission.
GOOGLE_SERVICE_ACCOUNT_EMAIL=face-signature-calendar@your-google-project.iam.gserviceaccount.com
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
GOOGLE_SERVICE_ACCOUNT_PROJECT_ID=your-google-project-id
